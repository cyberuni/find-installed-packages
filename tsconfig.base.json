{
	"compilerOptions": {
		"esModuleInterop": true,
		"isolatedModules": true,
		"lib": ["es2022"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"noUnusedLocals": true,
		"noUnusedParameters": false,
		"skipLibCheck": true,
		"strict": true,
		"target": "es2022",
		"verbatimModuleSyntax": true
	}
}
