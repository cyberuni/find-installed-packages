{
  "compilerOptions": {
    "esModuleInterop": true,
    "inlineSources": true,
    "lib": [
      "es2015"
    ],
    "moduleResolution": "node",
    "newLine": "LF",
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "removeComments": false,
    "sourceMap": true,
    "strict": true
  },
  "include": [
    "typings"
  ]
}
