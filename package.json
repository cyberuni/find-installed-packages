{
	"name": "find-installed-packages-monorepo",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "bun run --filter './packages/*' build",
		"changeset": "changeset",
		"clean": "bun run --filter './packages/*' clean",
		"coverage": "bun run --filter './packages/*' coverage",
		"cs": "changeset",
		"knip": "knip",
		"check": "biome check",
		"check:fix": "biome check --write",
		"postinstall": "husky install",
		"release": "changeset publish",
		"version": "changeset version",
		"test": "bun run --filter './packages/*' test",
		"verify": "npm-run-all clean -p knip build check coverage",
		"watch": "bun run --filter './packages/*' watch"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@changesets/cli": "^2.31.0",
		"@commitlint/cli": "17.8.1",
		"@commitlint/config-conventional": "17.8.1",
		"@repobuddy/biome": "2.3.1",
		"husky": "8.0.3",
		"knip": "latest",
		"npm-run-all2": "latest",
		"rimraf": "3.0.2",
		"typescript": "5.1.6"
	},
	"engines": {
		"node": ">=14",
		"bun": ">=1.0"
	}
}
