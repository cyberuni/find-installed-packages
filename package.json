{
	"name": "find-installed-packages-monorepo",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "bun run --filter './packages/*' build",
		"changeset": "changeset",
		"clean": "bun run --filter './packages/*' clean",
		"coverage": "bun run --filter './packages/*' coverage",
		"cs": "changeset",
		"knip": "knip",
		"check": "biome check",
		"check:fix": "biome check --write",
		"postinstall": "husky",
		"release": "changeset publish",
		"version": "changeset version",
		"test": "bun run --filter './packages/*' test",
		"typecheck": "tsc -p tsconfig.json && bun run --filter './packages/*' typecheck",
		"verify": "npm-run-all clean -p knip typecheck build check coverage",
		"watch": "bun run --filter './packages/*' watch"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@changesets/cli": "^3",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@repobuddy/biome": "2.3.1",
		"@repobuddy/typescript": "^2.1.0",
		"husky": "^9.1.7",
		"knip": "^6.34.0",
		"npm-run-all2": "^9.0.3",
		"rimraf": "^6.1.3",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=20.19",
		"bun": ">=1.0"
	}
}
