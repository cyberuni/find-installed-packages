{
  "name": "find-installed-packages",
  "version": "0.0.0-development",
  "description": "Find installed packages",
  "homepage": "https://github.com/unional/find-installed-packages",
  "bugs": {
    "url": "https://github.com/unional/find-installed-packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/unional/find-installed-packages.git"
  },
  "license": "MIT",
  "author": {
    "name": "Homa Wong (unional)",
    "email": "homawong@gmail.com"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "codacy": "cat coverage/lcov.info | codacy-coverage",
    "coverage": "bun test --coverage",
    "knip": "knip",
    "lint": "eslint --ext=js,ts .",
    "postinstall": "husky install",
    "prepack": "pinst --disable",
    "postpack": "pinst --enable",
    "test": "bun test",
    "verify": "npm-run-all clean -p build knip lint coverage",
    "watch": "bun test --watch"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "dependencies": {
    "temp": "^0.9.4",
    "unpartial": "^1.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "17.8.1",
    "@commitlint/config-conventional": "17.8.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "8.1.0",
    "@semantic-release/npm": "9.0.2",
    "@types/temp": "0.9.4",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "assertron": "11.5.0",
    "bun-types": "latest",
    "eslint": "8.56.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-harmony": "7.1.2",
    "husky": "8.0.3",
    "knip": "latest",
    "npm-run-all2": "latest",
    "pinst": "3.0.0",
    "rimraf": "3.0.2",
    "semantic-release": "19.0.5",
    "tsdown": "latest",
    "typescript": "5.1.6"
  },
  "engines": {
    "node": ">=14",
    "bun": ">=1.0"
  }
}
