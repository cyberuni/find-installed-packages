{
	"name": "find-installed-packages",
	"version": "4.0.0",
	"description": "Find installed packages",
	"homepage": "https://github.com/cyberuni/find-installed-packages",
	"bugs": {
		"url": "https://github.com/cyberuni/find-installed-packages/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/cyberuni/find-installed-packages.git"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com"
	},
	"type": "module",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"module": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"files": [
		"dist",
		"src",
		"!**/*.{spec,test,unit,accept,integrate,system,perf,stress,study,stories}.*"
	],
	"scripts": {
		"build": "tsdown",
		"clean": "rimraf dist",
		"codacy": "cat coverage/lcov.info | codacy-coverage",
		"coverage": "bun test --coverage",
		"test": "bun test",
		"typecheck": "tsc -p tsconfig.json",
		"verify": "npm-run-all clean -p build typecheck coverage",
		"watch": "bun test --watch"
	},
	"dependencies": {
		"package-manager-detector": "^1.8.0",
		"temp": "^0.9.4",
		"unpartial": "^1.0.2"
	},
	"devDependencies": {
		"@types/temp": "^0.9.4",
		"assertron": "^11.5.0",
		"bun-types": "latest",
		"tsdown": "latest"
	},
	"engines": {
		"bun": ">=1.0",
		"node": ">=20.19"
	}
}
