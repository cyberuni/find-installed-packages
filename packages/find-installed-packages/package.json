{
	"name": "find-installed-packages",
	"version": "3.1.2",
	"description": "Find installed packages",
	"homepage": "https://github.com/cyberuni/find-installed-packages",
	"bugs": {
		"url": "https://github.com/cyberuni/find-installed-packages/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/cyberuni/find-installed-packages.git"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com"
	},
	"exports": {
		".": {
			"source": "./src/index.ts",
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.cts",
	"files": [
		"dist",
		"src",
		"!**/*.{spec,test,unit,accept,integrate,system,perf,stress,study,stories}.*"
	],
	"scripts": {
		"build": "tsdown",
		"clean": "rimraf dist",
		"codacy": "cat coverage/lcov.info | codacy-coverage",
		"coverage": "bun test --coverage",
		"test": "bun test",
		"verify": "npm-run-all clean -p build lint coverage",
		"watch": "bun test --watch"
	},
	"dependencies": {
		"temp": "^0.9.4",
		"unpartial": "^1.0.2"
	},
	"devDependencies": {
		"@types/temp": "^0.9.4",
		"assertron": "^11.5.0",
		"bun-types": "latest",
		"tsdown": "latest"
	},
	"engines": {
		"bun": ">=1.0",
		"node": ">=14"
	}
}
